<Window x:Class="SignalGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Генератор сигналов"
        Height="760"
        Width="1200"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" />

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="Генерация сигналов"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="4,4,4,12" />

                <StackPanel>

                    <TextBlock Text="Тип сигнала"
                                   FontWeight="SemiBold" />

                    <ComboBox x:Name="SignalTypeComboBox"
                                  Margin="4"
                                  Height="30"
                                  SelectionChanged="SignalTypeComboBox_SelectionChanged" />

                    <Separator Margin="4,10" />

                    <TextBlock Text="Общие параметры"
                                   FontWeight="SemiBold" />

                    <Grid Margin="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Частота (Гц)" />
                            <TextBox x:Name="SamplingRateTextBox"
                                         Text="100" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Длительность (с)" />
                            <TextBox x:Name="DurationTextBox"
                                         Text="2" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="4,10" />

                    <TextBlock Text="Индивидуальные параметры"
                                   FontWeight="SemiBold" />

                    <StackPanel x:Name="SinePanel"
                                    Visibility="Visible">

                        <TextBlock Text="Синусоида"
                                       FontWeight="SemiBold"
                                       Margin="4,8" />

                        <TextBlock Text="Период (с)" />
                        <TextBox x:Name="PeriodTextBox"
                                     Text="1" />

                        <TextBlock Text="Фаза (с)" />
                        <TextBox x:Name="PhaseTextBox"
                                     Text="0" />

                        <TextBlock Text="Амплитуда" />
                        <TextBox x:Name="AmplitudeTextBox"
                                     Text="1" />
                    </StackPanel>

                    <StackPanel x:Name="TrianglePanel"
                Visibility="Collapsed">

                        <TextBlock Text="Треугольник"
                   FontWeight="SemiBold"
                   Margin="4,8" />

                        <TextBlock Text="Период (с)" />
                        <TextBox x:Name="TrianglePeriodTextBox"
                 Text="1" />

                        <TextBlock Text="Фаза (с)" />
                        <TextBox x:Name="TrianglePhaseTextBox"
                 Text="0" />

                        <TextBlock Text="Амплитуда" />
                        <TextBox x:Name="TriangleAmplitudeTextBox"
                 Text="1" />
                    </StackPanel>

                    <StackPanel x:Name="SawPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Пила"
                                   FontWeight="SemiBold"
                                   Margin="4,8" />

                        <TextBlock Text="Период (с)" />
                        <TextBox x:Name="SawPeriodTextBox"
                                 Text="1" />

                        <TextBlock Text="Фаза (с)" />
                        <TextBox x:Name="SawPhaseTextBox"
                                 Text="0" />

                        <TextBlock Text="Амплитуда" />
                        <TextBox x:Name="SawAmplitudeTextBox"
                                 Text="1" />
                    </StackPanel>

                    <StackPanel x:Name="ConstantPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Постоянная"
                                   FontWeight="SemiBold"
                                   Margin="4,8" />

                        <TextBlock Text="Значение" />
                        <TextBox x:Name="ConstantValueTextBox"
                                 Text="1" />
                    </StackPanel>

                    <StackPanel x:Name="LinePanel"
                                    Visibility="Collapsed">

                        <TextBlock Text="Прямая"
                                       FontWeight="SemiBold"
                                       Margin="4,8" />

                        <TextBlock Text="Коэффициент K" />
                        <TextBox x:Name="LineKTextBox"
                                     Text="2" />

                        <TextBlock Text="Свободный член B" />
                        <TextBox x:Name="LineBTextBox"
                                     Text="1" />
                    </StackPanel>

                    <StackPanel x:Name="NoisePanel"
                                    Visibility="Collapsed">

                        <TextBlock Text="Белый шум"
                                       FontWeight="SemiBold"
                                       Margin="4,8" />

                        <TextBlock Text="Размах R" />
                        <TextBox x:Name="NoiseRangeTextBox"
                                     Text="2" />

                        <TextBlock Text="Значения шума находятся в диапазоне [-R; R]"
                                       TextWrapping="Wrap"
                                       Margin="4"
                                       Foreground="Gray" />
                    </StackPanel>

                    <Button Content="Сгенерировать"
                                Height="42"
                                Margin="4,14,4,4"
                                FontWeight="Bold"
                                Click="Button_Click_Generate" />
                </StackPanel>

                <TextBlock Text="Операции над сигналами"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="4,8" />

                <WrapPanel>

                    <Button Content="Сумма"
                                Click="Button_Click_Summ" />

                    <Button Content="Склейка"
                                Click="Button_Click_Concat" />

                    <Button Content="Удалить"
                                Click="Button_Click_Remove" />

                    <Button Content="Сброс"
                                Click="Button_Clear" />
                </WrapPanel>


                <Separator Margin="4,10" />

                <TextBlock Text="Анализ пересечений"
           FontSize="18"
           FontWeight="Bold"
           Margin="4,8" />

                <StackPanel>
                    <TextBlock Text="Пороговое значение" />

                    <TextBox x:Name="ThresholdTextBox"
             Text="0" />

                    <Button Content="Найти пересечения"
            Height="36"
            Click="Button_FindMarkers_Click" />

                    <Button Content="Очистить маркеры"
            Height="36"
            Click="Button_ClearMarkers_Click" />

                    <TextBlock x:Name="SummaryTextBlock"
               Text="Найдено пересечений: 0"
               FontWeight="SemiBold"
               Margin="4,8" />

                    <TextBlock x:Name="DirectionCountTextBlock"
           Text="Вверх: 0 | Вниз: 0"
           Margin="4,4"
           FontWeight="SemiBold" />

                    <TextBlock x:Name="IntervalTextBlock"
           Text="Интервалы: не определены"
           Margin="4,4"
           FontWeight="SemiBold" />

                    <ListBox x:Name="MarkerListBox"
             Height="160"
             Margin="4"
             FontSize="13" />
                </StackPanel>


                <TextBlock Text="Фильтрация"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="4,8" />

                <StackPanel>

                    <TextBlock Text="Размер окна (с)" />
                    <TextBox x:Name="Window_textBox"
                                 Text="0.3" />

                    <WrapPanel>

                        <Button Content="Офлайн"
                                    Click="Button_Click_Offline" />

                        <Button Content="Онлайн"
                                    Click="Button_Click_Online" />
                    </WrapPanel>

                    <WrapPanel>

                        <Button Content="Медиана офлайн"
                                    Click="Button_Click_Median_Offline" />

                        <Button Content="Медиана онлайн"
                                    Click="Button_Click_Median_Online" />
                    </WrapPanel>
                </StackPanel>

                <TextBlock Text="Изменение частоты"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="4,8" />

                <StackPanel>

                    <TextBlock Text="Новая частота (Гц)" />

                    <TextBox x:Name="NewFreq_textBox"
                                 Text="20" />

                    <Button Content="Изменить частоту"
                                Click="Button_Click_Resample" />
                </StackPanel>

                <TextBlock Text="Работа с файлами"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="4,8" />

                <WrapPanel>

                    <Button Content="Загрузить"
                                Click="Button_Load" />

                    <Button Content="Сохранить"
                                Click="Button_Write" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>