<Window x:Class="SignalGenerator.App.MainWindow"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SignalGenerator.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" />
        <DockPanel Grid.Column="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Label Content="Длина(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="len_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="5" Margin="10,10,0,0"
     Height="20" Width="50"/>
                <Label Content="Частота(Гц)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="freq_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="10" Margin="10,10,0,0"
Height="20" Width="50"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="47" Orientation="Horizontal">
                <Button
        Content="Sin"
        HorizontalAlignment="Left"
        Width="50"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
        Click="Button_Click_Sin"/>
                <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
             Height="20" Width="50"/>
                <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="10" Margin="10,10,0,0"
Height="20" Width="50"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="47" Orientation="Horizontal">
                <Button
        Content="Прямая"
        HorizontalAlignment="Left"
        Width="50"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
        Click="Button_Click_Line"/>
                <Label Content="k" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="k_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
             Height="20" Width="50"/>
                <Label Content="b" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="b_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
Height="20" Width="50"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
        Content="Сброс"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
        Click="Button_Clear"/>

                <Button
        Content="Удалить"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Remove"/>
                <Button
Content="Загрузить"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Load"/>
                <Button
Content="Сохранить"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Write"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
        Content="Сумма"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Summ"/>

                <Button
        Content="Склейка"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Concat"/>


            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="50">
                <Button
                    Content="Шум"
                    HorizontalAlignment="Left"
                    Width="50"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_Noise"/>
                <Label Content="Амплитуда" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="Amplitude_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                    Height="20" Width="50"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
Content="Оф.фильтр"
HorizontalAlignment="Right"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Click_Offline"/>
                <Label Content="Окно(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="Window_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.2" Margin="10,10,0,0"
                Height="20" Width="50"/>
                <Button
Content="Он.фильтр"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Click_Offline"/>


            </StackPanel>


            
        </DockPanel>
    </Grid>
</Window>
